#Main openai api key
OPENAI_API_KEY=your_openai_api_key_here
#OpenAI vision model for image processing
OPENAI_VISION_MODEL="gpt-4o-mini"


#OpenAI model configuration for text-to-speech
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
#OpenAI voice configuration for text-to-speech
OPENAI_TTS_VOICE="coral"

#LangSmith API key for managing and tracking AI interactions
LANGSMITH_TRACING="True"
LANGSMITH_API_KEY="your_langsmith_api_key_here" 
LANGSMITH_PROJECT_NAME="multimodal_tutor_agent"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

#Local application configuration
UPLOAD_FOLDER="uploads"
AUDIO_FOLDER="audio"
MAX_UPLOAD_MB=20